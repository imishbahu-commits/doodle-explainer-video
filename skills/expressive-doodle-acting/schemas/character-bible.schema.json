{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doodle-explainer.local/schemas/character-bible.schema.json",
  "title": "Expressive Doodle Character Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "design", "identity_locks", "views", "expressions", "poses", "rig"],
  "properties": {
    "name": {"type": "string"},
    "design": {
      "type": "object",
      "required": ["head_to_body_ratio", "line_color", "palette", "silhouette_words"],
      "properties": {
        "head_to_body_ratio": {"type": "number", "minimum": 0.15, "maximum": 0.75},
        "line_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "palette": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "silhouette_words": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string"}},
        "asymmetry": {"type": "string"}
      }
    },
    "identity_locks": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "views": {"type": "array", "minItems": 3, "items": {"enum": ["front", "three-quarter-left", "three-quarter-right", "profile-left", "profile-right", "back"]}},
    "expressions": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "poses": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "rig": {
      "type": "object",
      "required": ["layers", "pivots", "deformers"],
      "properties": {
        "layers": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "pivots": {"type": "object", "additionalProperties": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}},
        "deformers": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

# Copy this file to .github/workflows/download-paint-explainer-references.yml
# when the GitHub credential has Actions workflow permission.
name: Download authorized Paint Explainer references

on:
  # The first push installs the frozen reference set. Later media commits do
  # not retrigger this job because the generated folder is not in these paths.
  push:
    branches:
      - arena/01a02418-doodle-explainer-video
    paths:
      - .github/workflows/download-paint-explainer-references.yml
      - scripts/download_paint_explainer_videos.py
      - references/paint-explainer-videos/catalog.json
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: paint-explainer-reference-import-${{ github.ref }}
  cancel-in-progress: false

jobs:
  download-and-commit:
    if: github.actor != 'github-actions[bot]'
    runs-on: ubuntu-latest
    timeout-minutes: 90

    steps:
      - name: Check out this branch with existing LFS objects
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          lfs: true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install downloader
        run: python -m pip install --upgrade "yt-dlp[default]"

      - name: Enable Git LFS
        run: git lfs install --local

      - name: Download the frozen 360p reference set
        run: python scripts/download_paint_explainer_videos.py

      - name: Commit and push LFS pointers and generated index
        env:
          BRANCH: ${{ github.ref_name }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .gitattributes references/paint-explainer-videos/
          if git diff --cached --quiet; then
            echo "Reference set is already current."
            exit 0
          fi
          git commit -m "Add 10 authorized Paint Explainer reference videos"
          git push origin "HEAD:${BRANCH}"
